[Unit]
Description=My-blog local capacity alarm

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/myblog-ops/myblog-health.py
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/myblog-health
StateDirectory=myblog-health
StandardOutput=journal
StandardError=journal
