# ============================
# MyBlog Docker 环境变量配置
# 复制到项目根目录 .env 并填写真实值：
#   cp docker/.env.example .env
# ============================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=blogdb
MYSQL_USER=bloguser
MYSQL_PASSWORD=replace-with-a-long-random-database-password

# ---- Redis ----
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=replace-with-a-random-rabbitmq-user
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-rabbitmq-password

# ---- JWT（如需覆盖 docker-compose 默认值）----
JWT_SECRET=replace-with-a-base64-secret-at-least-32-bytes
JWT_EXPIRATION=86400000

# ---- 管理员初始化（仅全新数据库首次启动时使用）----
BLOG_ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-admin-password

# ---- AI（通义千问 DashScope）----
# 在 docker/nginx/nginx.conf 中 proxy_set_header Authorization 填入此 Key
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ---- 说明 ----
# Compose 会强制要求上述敏感变量存在，不再使用仓库内默认凭据。
# .env 仅保存在部署机，不要提交到 Git。
